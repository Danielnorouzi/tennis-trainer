# ---------------------------------------------------------------------------------------------
# Rally AI configuration. Copy to .env.local and fill in what you need.
# Everything is optional: with no variables set, the app runs fully on-device (guest mode,
# live pose tracking, on-device reports) and AI features report "unavailable".
# ---------------------------------------------------------------------------------------------

# --- OpenAI (server-side only; never exposed to the browser) ---------------------------------
OPENAI_API_KEY=
# Detailed reports, stroke comparisons (image-capable model)
OPENAI_ANALYSIS_MODEL=gpt-6.1-sol
# Chat and training plans (cheaper model)
OPENAI_FAST_MODEL=gpt-6-luna
# Conversational voice coach (OpenAI Realtime API, WebRTC). Off by default.
ENABLE_REALTIME=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# "live" uses OpenAI. "fixture" returns deterministic, clearly labelled TEST data for local
# development without a key. Fixture mode is refused when NODE_ENV=production.
AI_MODE=live

# --- Cost & abuse controls (budget-conscious defaults) ----------------------------------------
# Image detail sent with key frames: low | high | auto  (low ≈ far fewer tokens)
AI_IMAGE_DETAIL=low
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT=4
# Requests per user per 10 minutes for reports/compare/plan (chat gets 2×)
AI_REQUESTS_PER_10_MIN=12
# Daily spend caps in USD (estimated from token usage)
AI_DAILY_BUDGET_USD_PER_USER=0.50
AI_DAILY_BUDGET_USD_GLOBAL=10
# USD per 1M tokens "input,output" used for the estimates above — update to current pricing
AI_PRICE_ANALYSIS=2,10
AI_PRICE_FAST=0.1,0.5

# --- Supabase (optional: accounts, cloud sync, private video storage) -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for the AI usage ledger and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
