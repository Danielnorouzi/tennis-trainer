// Regenerates supabase/seed.sql from the drill library so the database and app never drift.
//   node scripts/gen-drill-seed.mts
import { writeFileSync } from "node:fs";
import { DRILLS } from "../src/lib/tennis/drills.ts";

const q = (s: string) => `'${s.replaceAll("'", "''")}'`;
const arr = (xs: string[]) => `array[${xs.map(q).join(", ")}]::text[]`;
const rows = DRILLS.map((d) =>
  `(${q(d.id)}, ${q(d.title)}, ${q(d.category)}, ${arr(d.focus)}, ${q(d.objective)}, ${arr(d.instructions)}, ${q(d.reps)}, ${d.durationMin}, ${q(d.difficulty)}, ${arr(d.commonMistakes)}, ${arr(d.successCriteria)}, ${d.needsBall}, ${d.needsCourt})`,
);
const sql = `-- Generated by scripts/gen-drill-seed.mts — do not edit by hand.
insert into public.drills (id, title, category, focus, objective, instructions, reps, duration_min, difficulty, common_mistakes, success_criteria, needs_ball, needs_court)
values
${rows.join(",\n")}
on conflict (id) do update set
  title = excluded.title, category = excluded.category, focus = excluded.focus, objective = excluded.objective,
  instructions = excluded.instructions, reps = excluded.reps, duration_min = excluded.duration_min,
  difficulty = excluded.difficulty, common_mistakes = excluded.common_mistakes,
  success_criteria = excluded.success_criteria, needs_ball = excluded.needs_ball, needs_court = excluded.needs_court;
`;
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`wrote ${DRILLS.length} drills to supabase/seed.sql`);
